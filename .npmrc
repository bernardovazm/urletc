# typescript-eslint 8.x still declares a peer range of TypeScript <6.0.0, but this repo
# runs TypeScript 6.x. The parser handles TS 6 fine (verified: eslint parses the whole
# tree clean); this flag lets `npm install` resolve without a spurious peer error.
# `npm ci` installs from the committed lockfile and is unaffected. Remove once
# typescript-eslint widens its peer range to include TS 6.
legacy-peer-deps=true
save-exact=true
